{
  "name": "mcg-workspace",
  "private": true,
  "version": "0.4.40",
  "workspaces": [
    "apps/desktop"
  ],
  "scripts": {
    "check:docs": "node scripts/check-docs.mjs",
    "check:packaging": "node scripts/check-packaging.mjs",
    "check": "npm run typecheck --workspace @mcg/desktop",
    "test": "npm run test --workspace @mcg/desktop",
    "test:updater-signing": "node scripts/test-updater-signing.mjs",
    "test:release-artifact-scan": "node scripts/test-scan-release-artifacts.mjs",
    "test:updater-uat-server": "node scripts/test-updater-uat-server.mjs",
    "serve:updater-uat": "node scripts/updater-uat-server.mjs",
    "prepare:updater-uat-source": "node scripts/prepare-updater-uat-source.mjs",
    "test:prepare-updater-uat-source": "node scripts/test-prepare-updater-uat-source.mjs",
    "prepare:updater-uat-workspace": "node scripts/prepare-updater-uat-workspace.mjs",
    "test:prepare-updater-uat-workspace": "node scripts/test-prepare-updater-uat-workspace.mjs",
    "write:updater-manifest": "node scripts/write-updater-manifest.mjs",
    "write:updater-uat-scenarios": "node scripts/write-updater-uat-scenarios.mjs",
    "test:release-soak": "node scripts/test-release-soak.mjs",
    "test:release-soak-unattended": "node scripts/test-release-soak-unattended.mjs",
    "test:verify-release-soak-evidence": "node scripts/test-verify-release-soak-evidence.mjs",
    "verify:release-soak-evidence": "node scripts/verify-release-soak-evidence.mjs",
    "scan:release-artifacts": "node scripts/scan-release-artifacts.mjs",
    "build": "npm run build --workspace @mcg/desktop",
    "build:portable:windows": "pwsh -NoProfile -File scripts/build-portable-windows.ps1",
    "dev": "npm run dev --workspace @mcg/desktop",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@modelcontextprotocol/client": "2.0.0",
    "@playwright/test": "1.62.1",
    "jsdom": "29.1.1"
  }
}
